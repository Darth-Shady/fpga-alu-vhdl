-- Combiner

LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY Combiner IS
    PORT ( X  : IN  STD_LOGIC_VECTOR(7 DOWNTO 0);
           Y : IN  STD_LOGIC_VECTOR(15 DOWNTO 8);
           Z  : OUT STD_LOGIC_VECTOR(15 DOWNTO 0) );
END Combiner;

ARCHITECTURE Behavior OF Combiner IS
BEGIN

	Z <= Y & X; 

END Behavior;