LIBRARY ieee;
USE ieee.std_logic_1164.ALL;
USE ieee.std_logic_unsigned.ALL;
USE ieee.numeric_std.ALL;

ENTITY ALU IS
    PORT ( Clock      : IN  STD_LOGIC;
           A, B       : IN  STD_LOGIC_VECTOR(7 DOWNTO 0);
           student_id : IN  STD_LOGIC_VECTOR(3 DOWNTO 0);  -- 4-bit from FSM
           OP         : IN  STD_LOGIC_VECTOR(15 DOWNTO 0); -- operation selector from decoder
           Neg        : OUT STD_LOGIC;
           R1         : OUT STD_LOGIC_VECTOR(3 DOWNTO 0);  -- lower 4 bits of result
           R2         : OUT STD_LOGIC_VECTOR(3 DOWNTO 0) );-- upper 4 bits of result
END ALU;

ARCHITECTURE Calculation OF ALU IS
    SIGNAL Reg1, Reg2, Result : STD_LOGIC_VECTOR(7 DOWNTO 0) := (OTHERS => '0');
    SIGNAL Reg4               : STD_LOGIC_VECTOR(8 DOWNTO 0) := (OTHERS => '0'); -- 9-bit for carry/overflow detection
BEGIN
    Reg1 <= A;
    Reg2 <= B;

    PROCESS (Clock, OP)
    BEGIN
        IF rising_edge(Clock) THEN
            Neg <= '0'; -- default, override below if needed
            CASE OP IS

                WHEN "0000000000000001" =>  -- Function 1: sum(A, B)
                    Reg4   <= ('0' & Reg1) + ('0' & Reg2);
                    Result <= Reg4(7 DOWNTO 0);

                WHEN "0000000000000010" =>  -- Function 2: diff(A, B)
                    IF Reg1 < Reg2 THEN
                        Result <= Reg2 - Reg1;
                        Neg    <= '1';
                    ELSE
                        Result <= Reg1 - Reg2;
                        Neg    <= '0';
                    END IF;

                WHEN "0000000000000100" =>  -- Function 3: NOT A
                    Result <= NOT Reg1;

                WHEN "0000000000001000" =>  -- Function 4: NOT(A AND B)  (NAND)
                    Result <= NOT (Reg1 AND Reg2);

                WHEN "0000000000010000" =>  -- Function 5: NOT(A OR B)  (NOR)
                    Result <= NOT (Reg1 OR Reg2);

                WHEN "0000000000100000" =>  -- Function 6: A AND B
                    Result <= Reg1 AND Reg2;

                WHEN "0000000001000000" =>  -- Function 7: A XOR B
                    Result <= Reg1 XOR Reg2;

                WHEN "0000000010000000" =>  -- Function 8: A OR B
                    Result <= Reg1 OR Reg2;

                WHEN "0000000100000000" =>  -- Function 9: A XNOR B
                    Result <= Reg1 XNOR Reg2;

                WHEN OTHERS =>
                    Result <= (OTHERS => '0');

            END CASE;
        END IF;
    END PROCESS;

    -- Split 8-bit result into two 4-bit outputs for 7-seg displays
    R1 <= Result(3 DOWNTO 0);   -- lower nibble ? HEX0/HEX2
    R2 <= Result(7 DOWNTO 4);   -- upper nibble ? HEX1/HEX3

END Calculation;